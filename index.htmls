<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wielka Kula 3D - Działa na iPhone</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background: radial-gradient(circle, #252535, #0c0c12);
            font-family: Arial, sans-serif;
            overflow: hidden;
            user-select: none;
            -webkit-user-select: none; /* Dla Safari na iPhone */
        }

        .kula-btn {
            width: 280px;
            height: 280px;
            font-size: 32px;
            font-weight: bold;
            color: #ffffff;
            border: none;
            border-radius: 50%;
            cursor: pointer;
            outline: none;
            text-transform: uppercase;
            letter-spacing: 2px;
            text-shadow: 2px 2px 5px rgba(0, 0, 0, 0.6);
            
            /* Efekt kuli 3D */
            background: radial-gradient(circle at 80px 80px, #ff6b8b, #ff003c, #990024);
            
            /* Cienie dające trójwymiarowość */
            box-shadow: 
                0 30px 50px rgba(0, 0, 0, 0.7),
                inset -20px -20px 40px rgba(0, 0, 0, 0.6),
                inset 15px 15px 30px rgba(255, 255, 255, 0.4);
                
            transition: transform 0.1s ease;
            -webkit-tap-highlight-color: transparent; /* Usuwa brzydki szary blask na iPhone */
        }

        /* Kliknięcie - wciśnięcie kuli */
        .kula-btn:active {
            transform: scale(0.95) translateY(5px);
        }
    </style>
</head>
<body>

    <button class="kula-btn" id="button-kula">KLIK!</button>

    <audio id="click-sound" preload="auto" playsinline>
        <source src="data:audio/wav;base64,UklGRigAAABXQVZFZm10IBAAAAABAAEARKwAAIhYAQACABAAZGF0YQQAAAAAAAAnACcAJwAn" type="audio/wav">
        <source src="https://www.soundjay.com/buttons/sounds/button-4.mp3" type="audio/mpeg">
    </audio>

    <script>
        const przycisk = document.getElementById('button-kula');
        const dzwiek = document.getElementById('click-sound');

        // Specjalne nasłuchiwanie na dotyk (dla iPhone'a to działa najlepiej)
        przycisk.addEventListener('touchstart', function(e) {
            odtworz();
        });

        // Dla zwykłych myszek na komputerze
        przycisk.addEventListener('mousedown', function(e) {
            odtworz();
        });

        function odtworz() {
            // Reset czasu i natychmiastowe odtworzenie istniejacego elementu
            dzwiek.currentTime = 0;
            
            // Replay na iOS wymaga bezpośredniego wywołania
            var playPromise = dzwiek.play();
            
            if (playPromise !== undefined) {
                playPromise.catch(error => {
                    console.log("Błąd odtwarzania:", error);
                });
            }
        }
    </script>

</body>
</html>
